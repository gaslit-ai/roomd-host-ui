OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# chat persistence -- sign up on cloud.assistant-ui.com
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# MCP server URL used by the server-side MCP host kernel (Streamable HTTP).
# MCP_SERVER_URL=http://localhost:8090/rooms/example/mcp

# MCP Apps sandbox proxy URL. Must be an absolute URL on an origin different
# from the app host, and should serve public/mcp-sandbox.html. Local dev falls
# back to the alternate loopback host on the same port, e.g.
# http://127.0.0.1:3000/mcp-sandbox.html when the app is opened on localhost.
# NEXT_PUBLIC_MCP_SANDBOX_URL=https://mcp-sandbox.example.com/mcp-sandbox.html

# Server-side log level. Defaults: "debug" in dev, "info" in production.
# Valid: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=debug

# Browser log level. Defaults to "info" (even in dev) to keep devtools quiet;
# flip to "debug" when investigating.
# NEXT_PUBLIC_LOG_LEVEL=info

# DEV-ONLY escape hatch: relaxes the MCP Apps sandbox CSP to include
# `'unsafe-eval'`. Required for generative widgets that run LLM-produced
# code via `new Function(...)` or `eval(...)`. SEP-1865's McpUiResourceCsp
# has no spec-blessed way to declare this need, so this flag is opt-in.
# When set, the app header shows a visible "Unsafe eval" chip with a
# hover explanation of the risk. Only enable against trusted MCP servers.
# Truthy values: 1 | true | yes | on.
# NEXT_PUBLIC_DANGEROUSLY_ALLOW_UNSAFE_EVAL=1
